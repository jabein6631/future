{
  "name": "skill-swap-platform",
  "version": "1.0.0",
  "description": "SkillSwap: Cashless Peer-to-Peer Skill Exchange with AI Dynamic 20-Q Assessment, Negative Marking (+3/-1/0), and 4-Tier Tutor Classification for Vignan University",
  "main": "api/index.js",
  "scripts": {
    "start": "node backend/server.js",
    "seed": "node backend/database/seed.js",
    "clean": "node backend/database/clean_db.js",
    "dev:server": "node --watch backend/server.js",
    "dev": "vite",
    "prebuild": "node -e \"const fs=require('fs'); ['css','js','assets'].forEach(d => { if(fs.existsSync('frontend/'+d)) fs.cpSync('frontend/'+d, 'public/'+d, {recursive:true}); });\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "skill-swap",
    "peer-learning",
    "time-banking",
    "trusodb",
    "ai-quiz",
    "negative-marking",
    "vignan-university"
  ],
  "author": "Sri Dhanush (Vignan University)",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@libsql/client": "^0.18.0",
    "@supabase/supabase-js": "^2.49.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sqlite3": "^5.1.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
